  assertValidHttpProtocolURL(requestedURL, config);\n  let isRelativeUrl = !isAbsoluteURL(requestedURL);\n  if (baseURL && (isRelativeUrl || allowAbsoluteUrls === false)) {\n    assertValidHttpProtocolURL(baseURL, config);\n    return combineURLs(baseURL, requestedURL);\n  }\n  return requestedURL;\n}\n"],"mappings":"AAAA,YAAY;;AAAC;AAEb,OAAOA,UAAU,IAAIC,QAAQ,QAAQ,iBAAiB;AACtD,OAAOC,aAAa,MAAM,6BAA6B;AACvD,OAAOC,WAAW,MAAM,2BAA2B;AACnD,OAAOC,4BAA4B,MAAM,4CAA4C;AAErF,MAAMC,qBAAqB,GAAG,mBAAmB;;AAEjD;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,SAASC,cAAcA,CAACC,QAAQ,EAAE;EAChC,IAAI,CAACA,QAAQ,EAAE;IACb,OAAOA,QAAQ;EACjB;EAEA,OAAOA,QAAQ,CAACC,OAAO,CAAC,uBAAuB,EAAE,CAACC,KAAK,EAAEC,SAAS,EAAEC,aAAa,GAAG,EAAE,KAAK;IACzF,OAAO,GAAGD,SAAS,GAAGC,aAAa,GAAGV,QAAQ,EAAE;EAClD,CAAC,CAAC;AACJ;AAEA,SAASW,uBAAuBA,CAACC,GAAG,EAAE;EACpC,MAAMC,WAAW,GAAGD,GAAG,CAACL,OAAO,CAAC,4BAA4B,EAAE,KAAKP,QAAQ,GAAG,CAAC;EAC/E,MAAMc,aAAa,GAAGD,WAAW,CAACE,OAAO,CAAC,GAAG,CAAC;EAC9C,MAAMC,kBAAkB,GACtBF,aAAa,KAAK,CAAC,CAAC,GAAGD,WAAW,GAAGA,WAAW,CAACI,KAAK,CAAC,CAAC,EAAEH,aAAa,CAAC;EAC1E,MAAMI,0BAA0B,GAAGF,kBAAkB,CAACT,OAAO,CAC3D,uBAAuB,EACvB,KAAKP,QAAQ,EACf,CAAC;EAED,IAAIc,aAAa,KAAK,CAAC,CAAC,EAAE;IACxB,OAAOI,0BAA0B;EACnC;EAEA,OAAO,GAAGA,0BAA0B,IAAIb,cAAc,CAACQ,WAAW,CAACI,KAAK,CAACH,aAAa,GAAG,CAAC,CAAC,CAAC,EAAE;AAChG;AAEA,SAASK,0BAA0BA,CAACP,GAAG,EAAEQ,MAAM,EAAE;EAC/C,IAAI,OAAOR,GAAG,KAAK,QAAQ,EAAE;IAC3B,MAAMS,aAAa,GAAGlB,4BAA4B,CAACS,GAAG,CAAC;IACvD,IAAIR,qBAAqB,CAACkB,IAAI,CAACD,aAAa,CAAC,EAAE;MAC7C,MAAM,IAAItB,UAAU,CAClB,eAAewB,IAAI,CAACC,SAAS,CAACb,uBAAuB,CAACU,aAAa,CAAC,CAAC,+BAA+B,EACpGtB,UAAU,CAAC0B,eAAe,EAC1BL,MACF,CAAC;IACH;EACF;AACF;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,eAAe,SAASM,aAAaA,CAACC,OAAO,EAAEC,YAAY,EAAEC,iBAAiB,EAAET,MAAM,EAAE;EACtFD,0BAA0B,CAACS,YAAY,EAAER,MAAM,CAAC;EAChD,IAAIU,aAAa,GAAG,CAAC7B,aAAa,CAAC2B,YAAY,CAAC;EAChD,IAAID,OAAO,KAAKG,aAAa,IAAID,iBAAiB,KAAK,KAAK,CAAC,EAAE;IAC7DV,0BAA0B,CAACQ,OAAO,EAAEP,MAAM,CAAC;IAC3C,OAAOlB,WAAW,CAACyB,OAAO,EAAEC,YAAY,CAAC;EAC3C;EACA,