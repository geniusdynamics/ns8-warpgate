{"remainingRequest":"/home/user/ns8-warpgate/ui/node_modules/vue-loader/lib/index.js??vue-loader-options!/home/user/ns8-warpgate/ui/src/components/AppSideMenuContent.vue?vue&type=style&index=0&id=4e0acfae&prod&scoped=true&lang=scss","dependencies":[{"path":"/home/user/ns8-warpgate/ui/src/components/AppSideMenuContent.vue","mtime":1794507838815},{"path":"/home/user/ns8-warpgate/ui/node_modules/css-loader/dist/cjs.js","mtime":1794508389108},{"path":"/home/user/ns8-warpgate/ui/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1794508388076},{"path":"/home/user/ns8-warpgate/ui/node_modules/postcss-loader/src/index.js","mtime":1794508389164},{"path":"/home/user/ns8-warpgate/ui/node_modules/sass-loader/dist/cjs.js","mtime":1794508387948},{"path":"/home/user/ns8-warpgate/ui/node_modules/cache-loader/dist/cjs.js","mtime":1794508389072},{"path":"/home/user/ns8-warpgate/ui/node_modules/vue-loader/lib/index.js","mtime":1794508388072}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:Ci5pbnN0YW5jZS1uYW1lIHNwYW4gewogIG92ZXJmbG93OiBoaWRkZW47CiAgdGV4dC1vdmVyZmxvdzogZWxsaXBzaXM7CiAgd2hpdGUtc3BhY2U6IG5vd3JhcDsKfQo="},{"version":3,"sources":["AppSideMenuContent.vue"],"names":[],"mappings":";AAqFA;AACA;AACA;AACA;AACA","file":"AppSideMenuContent.vue","sourceRoot":"src/components","sourcesContent":["<!--\n  Copyright (C) 2023 Nethesis S.r.l.\n  SPDX-License-Identifier: GPL-3.0-or-later\n-->\n<template>\n  <div class=\"app-side-menu-content\">\n    <div class=\"instance-name\">\n      <div v-if=\"instanceLabel\">{{ instanceLabel }}</div>\n      <div v-else-if=\"instanceName\">{{ instanceName }}</div>\n      <cv-skeleton-text\n        v-else\n        :width=\"instanceNameSkeletonWidth\"\n      ></cv-skeleton-text>\n    </div>\n\n    <cv-side-nav-items>\n      <cv-side-nav-link\n        @click=\"goToAppPage(instanceName, 'status')\"\n        :class=\"{ 'current-page': isLinkActive('status') }\"\n      >\n        <template v-slot:nav-icon><Activity20 /></template>\n        <span>{{ $t(\"status.title\") }}</span>\n      </cv-side-nav-link>\n      <cv-side-nav-link\n        @click=\"goToAppPage(instanceName, 'settings')\"\n        :class=\"{ 'current-page': isLinkActive('settings') }\"\n      >\n        <template v-slot:nav-icon><Settings20 /></template>\n        <span>{{ $t(\"settings.title\") }}</span>\n      </cv-side-nav-link>\n      <cv-side-nav-link\n        @click=\"goToAppPage(instanceName, 'about')\"\n        :class=\"{ 'current-page': isLinkActive('about') }\"\n      >\n        <template v-slot:nav-icon><Information20 /></template>\n        <span>{{ $t(\"about.title\") }}</span>\n      </cv-side-nav-link>\n    </cv-side-nav-items>\n  </div>\n</template>\n\n<script>\nimport Settings20 from \"@carbon/icons-vue/es/settings/20\";\nimport Information20 from \"@carbon/icons-vue/es/information/20\";\nimport Activity20 from \"@carbon/icons-vue/es/activity/20\";\nimport { mapState } from \"vuex\";\nimport { QueryParamService, UtilService } from \"@nethserver/ns8-ui-lib\";\n\nexport default {\n  name: \"AppSideMenuContent\",\n  components: {\n    Settings20,\n    Information20,\n    Activity20,\n  },\n  mixins: [QueryParamService, UtilService],\n  data() {\n    return {\n      instanceNameSkeletonWidth: \"70%\",\n    };\n  },\n  computed: {\n    ...mapState([\"instanceName\", \"instanceLabel\", \"core\"]),\n  },\n  created() {\n    // register to appNavigation event\n    this.$root.$on(\"appNavigation\", this.onAppNavigation);\n  },\n  beforeDestroy() {\n    // remove event listener\n    this.$root.$off(\"appNavigation\");\n  },\n  methods: {\n    isLinkActive(page) {\n      return this.getPage() === page;\n    },\n    onAppNavigation() {\n      // highlight current page in side menu\n      this.$forceUpdate();\n    },\n  },\n};\n</script>\n\n<style scoped lang=\"scss\">\n.instance-name span {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n</style>\n"]}]}