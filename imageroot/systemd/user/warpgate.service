#
# This systemd unit starts a Warpgate instance using Podman.
#
[Unit]
Description=Warpgate bastion

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# WARPGATE_ADMIN_PASSWORD, generated by create-module (secret, mode 0600)
EnvironmentFile=-%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/warpgate.pid %t/warpgate.ctr-id
# First-run setup: writes /data/warpgate.yaml, the database and the admin
# user. It is a no-op if the configuration already exists. The admin
# password is read from the environment, not from the command line.
ExecStartPre=/usr/bin/podman run \
    --rm \
    --volume=data:/data:Z \
    --env=WARPGATE_ADMIN_PASSWORD \
    ${WARPGATE_IMAGE} \
    unattended-setup \
    --data-path=/data \
    --http-port=8888 \
    --ssh-port=2222 \
    --mysql-port=33306 \
    --external-host=${TRAEFIK_HOST} \
    --if-config-exists=skip
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/warpgate.pid \
    --cidfile=%t/warpgate.ctr-id \
    --cgroups=no-conmon \
    --replace --name=%N \
    --volume=data:/data:Z \
    --publish=127.0.0.1:${TCP_PORT_HTTP}:8888 \
    --publish=${TCP_PORT_SSH}:2222 \
    --publish=${TCP_PORT_MYSQL}:33306 \
    ${WARPGATE_IMAGE} \
    run
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/warpgate.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/warpgate.ctr-id
PIDFile=%t/warpgate.pid
Type=forking

[Install]
WantedBy=default.target
