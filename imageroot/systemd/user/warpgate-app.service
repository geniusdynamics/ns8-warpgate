[Unit]
Description=Podman  warpgate-app.service
BindsTo=warpgate.service
After=warpgate.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/smarthost.env
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p tmp
ExecStartPre=/bin/rm -f %t/warpgate-app.pid %t/warpgate-app.ctr-id
ExecStartPre=-runagent discover-smarthost
ExecStart=/usr/bin/podman run --conmon-pidfile %t/warpgate-app.pid  --cidfile %t/warpgate-app.ctr-id --cgroups=no-conmon  --pod-id-file %t/warpgate.pod-id --replace -d --name  warpgate-app  --volume data:/data:Z   --env-file warpgate.env  ${WARPGATE_IMAGE}  
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/warpgate-app.ctr-id -t 10
ExecReload=/usr/bin/podman kill -s HUP warpgate-app
SyslogIdentifier=%u
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/warpgate-app.ctr-id
PIDFile=%t/warpgate-app.pid
Type=forking

[Install]
WantedBy=default.target
