# Ask an ns8-openbao instance for client access (request-client-access).
# It grants nothing: the OpenBao administrator approves the request.
import json
import sys

import warpgate_cluster as wc

data = json.load(sys.stdin)
status = wc.openbao_client_call(data["openbao"], "request-client-access")
if status is None:
    json.dump([{"field": "openbao", "parameter": "openbao", "value": data["openbao"],
                "error": "openbao_request_failed"}], sys.stdout)
    sys.exit(2)
json.dump(status, sys.stdout)
