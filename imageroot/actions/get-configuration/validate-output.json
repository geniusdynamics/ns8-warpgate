{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get warpgate settings",
    "$id": "http://nethserver.org/json-schema/task/input/warpgate/get-configuration",
    "description": "Get warpgate settings",
    "examples": [
        {
            "host": "warpgate.domain.org",
            "http2https": true,
            "lets_encrypt": true
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'warpgate.domain.org'",
            "format": "idn-hostname"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "oidc_callback_path": {
            "type": "string"
        },
        "oidc_providers": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "label",
                    "domains"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "domains": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "oidc": {
            "type": "object",
            "required": [
                "mode"
            ],
            "properties": {
                "mode": {
                    "enum": [
                        "disabled",
                        "manual",
                        "ns8"
                    ]
                },
                "issuer": {
                    "type": "string"
                },
                "client_id": {
                    "type": "string"
                },
                "provider": {
                    "type": "string"
                },
                "domain": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "maxLength": 120
                }
            },
            "additionalProperties": false
        },
        "oidc_entries": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "mode"
                ],
                "properties": {
                    "mode": {
                        "enum": [
                            "manual",
                            "ns8"
                        ]
                    },
                    "issuer": {
                        "type": "string"
                    },
                    "client_id": {
                        "type": "string"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "domain": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string",
                        "maxLength": 120
                    }
                },
                "additionalProperties": false
            }
        },
        "database": {
            "type": "object",
            "required": [
                "mode",
                "password_set"
            ],
            "properties": {
                "mode": {
                    "enum": [
                        "embedded",
                        "postgresql19c"
                    ]
                },
                "instance": {
                    "type": "string"
                },
                "provider": {
                    "type": "string"
                },
                "database": {
                    "type": "string"
                },
                "host": {
                    "type": "string"
                },
                "port": {
                    "type": "integer"
                },
                "cluster_id": {
                    "type": "string"
                },
                "password_set": {
                    "type": "boolean"
                }
            }
        },
        "postgresql19c_instances": {
            "type": "array",
            "items": {
                "type": "object"
            }
        },
        "cluster": {
            "type": "object",
            "required": [
                "mode"
            ],
            "properties": {
                "mode": {
                    "enum": [
                        "standalone",
                        "create",
                        "join"
                    ]
                },
                "peer": {
                    "type": "string"
                }
            }
        },
        "peer_candidates": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "module_id",
                    "node",
                    "allowed"
                ]
            }
        },
        "vault_enabled": {
            "type": "boolean"
        },
        "vault_mode": {
            "enum": [
                "manual",
                "provisioned"
            ]
        },
        "vault_openbao": {
            "type": "string"
        },
        "vault_address": {
            "type": "string"
        },
        "vault_token_set": {
            "type": "boolean"
        },
        "vault_mount": {
            "type": "string"
        },
        "vault_path": {
            "type": "string"
        },
        "openbao_servers": {
            "type": "array",
            "items": {
                "type": "object"
            }
        }
    }
}
