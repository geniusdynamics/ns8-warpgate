import json
import os
import sys

import agent
import warpgate_cluster as wc
import warpgate_oidc
import warpgate_recordings
import warpgate_secret_backend

config = {
    "host": os.getenv("TRAEFIK_HOST", ""),
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": os.getenv("TRAEFIK_LETS_ENCRYPT") == "True",
}

entries = warpgate_oidc.read_settings()
visible = {"mode", "provider", "domain", "issuer", "client_id", "label"}
config["oidc_entries"] = [
    {key: value for key, value in entry.items() if key in visible}
    for entry in entries
]
config["oidc"] = config["oidc_entries"][0] if entries else {"mode": "disabled"}
config["oidc_providers"] = [
    {key: provider[key] for key in ("id", "label", "domains")}
    for provider in warpgate_oidc.discover(agent.redis_connect()).values()
]
config["oidc_callback_path"] = warpgate_oidc.CALLBACK

# Database, cluster and OpenBao settings: no secrets, only *_set flags
rdb = agent.redis_connect(use_replica=True)
cur = wc.settings()
config["database"] = {
    "mode": cur["db_mode"], "instance": cur["db_instance"], "provider": cur["db_provider"],
    "database": cur["db_name"], "host": cur["db_host"], "port": int(cur["db_port"] or 0),
    "cluster_id": cur["db_cluster_id"], "password_set": bool(wc.database_password()),
}
config["postgresql19c_instances"] = [
    {key: rec[key] for key in ("module_id", "node", "cluster_id", "ha_mode")} for rec in wc.pg_records(rdb)
]
config["cluster"] = {"mode": cur["cluster_mode"], "peer": cur["cluster_peer"]}
config["peer_candidates"] = wc.peer_candidates(rdb)
config.update(wc.vault_settings())
config["openbao_servers"] = sorted(
    ({"module_id": module_id, "node": str(node_id), "ui_name": rdb.get(f"module/{module_id}/ui_name") or ""}
     for module_id, node_id in (rdb.hgetall("cluster/module_node") or {}).items()
     if wc.image_name_of(rdb.hget(f"module/{module_id}/environment", "IMAGE_URL")) == "openbao"),
    key=lambda item: item["module_id"],
)
if config.get("vault_openbao"):
    config["openbao_client_status"] = wc.openbao_client_call(config["vault_openbao"], "get-client-status") or {}

# Recordings storage: no secret key, only secret_access_key_set
recordings = warpgate_recordings.settings()
recordings["inherited_from"] = cur["cluster_peer"] if cur["cluster_mode"] == "join" else ""
recordings["warnings"] = warpgate_recordings.warnings(recordings, cur["cluster_mode"])
config["recordings"] = recordings

# Warpgate secret backend: settings and the values to enter in Warpgate
# (address, KV mount, allowed path, policy), never a token
backend = warpgate_secret_backend.settings()
backend["info"] = warpgate_secret_backend.info(backend)
backend["warnings"] = warpgate_secret_backend.warnings(backend)
status = config.get("openbao_client_status") or {}
backend["groups"] = sorted(set(status.get("groups") or []) | set(wc.read_group_tokens()))
config["secret_backend"] = backend

json.dump(config, fp=sys.stdout)
