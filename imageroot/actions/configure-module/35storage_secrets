#
# Recordings storage and Warpgate secret backend settings. Both live in
# Warpgate's database in 0.30, so the module writes them with the admin API
# once Warpgate runs again (90warpgate_parameters). Here: save the
# settings (the S3 secret key goes to the 0600 file state/s3.env) and
# decide whether Warpgate starts with the admin token enabled.
#

import json
import os
import sys

import agent
import warpgate_api
import warpgate_cluster as wc
import warpgate_recordings
import warpgate_secret_backend

request = json.load(sys.stdin)
cluster_mode = wc.settings()["cluster_mode"]

if cluster_mode != "join":
    # A joining member got the recordings settings of its peer (30cluster)
    want = warpgate_recordings.requested(request, warpgate_recordings.settings())
    warpgate_recordings.save(want)

backend = warpgate_secret_backend.requested(request, warpgate_secret_backend.settings())
warpgate_secret_backend.save(backend)
if (backend["mode"] == "managed" and backend["scope"] == "group"
        and backend["group"] not in wc.read_group_tokens()):
    # Group tokens come with a provisioning: get them now, if approved
    vs = wc.vault_settings()
    try:
        address, token, mount, path = wc.provision(vs["vault_openbao"])
    except wc.ClusterError as error:
        wc.fail(wc.ClusterError("secret_backend_group", error.code, backend["group"]))
    wc.save_vault_env(address, token)
    agent.mset_env({"WARPGATE_VAULT_MOUNT": mount, "WARPGATE_VAULT_PATH": path})
    os.environ.update({"WARPGATE_VAULT_MOUNT": mount, "WARPGATE_VAULT_PATH": path})
    if backend["group"] not in wc.read_group_tokens():
        wc.fail(wc.ClusterError("secret_backend_group", "secret_backend_group_not_approved", backend["group"]))

enabled = (warpgate_recordings.needs_admin_api(cluster_mode=cluster_mode)
           or warpgate_secret_backend.needs_admin_api(cluster_mode=cluster_mode))
agent.set_env("WARPGATE_RUN_ARGS", warpgate_api.run_args(enabled))
