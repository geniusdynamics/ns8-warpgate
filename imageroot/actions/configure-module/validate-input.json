{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure warpgate",
    "$id": "http://nethserver.org/json-schema/task/input/warpgate/configure-module",
    "description": "Configure warpgate",
    "examples": [
        {
            "host": "warpgate.domain.org",
            "http2https": true,
            "lets_encrypt": true
        },
        {
            "host": "warpgate2.domain.org",
            "http2https": true,
            "lets_encrypt": true,
            "database": {
                "mode": "postgresql19c",
                "instance": ""
            },
            "cluster": {
                "mode": "join",
                "peer": "warpgate1"
            },
            "vault_enabled": true,
            "vault_mode": "provisioned",
            "vault_openbao": "openbao1"
        },
        {
            "host": "warpgate.domain.org",
            "http2https": true,
            "lets_encrypt": false,
            "recordings": {
                "storage": "s3",
                "endpoint": "https://s3.example.org",
                "region": "us-east-1",
                "bucket": "warpgate-recordings",
                "prefix": "warpgate1",
                "path_style": true,
                "access_key_id": "AKIAEXAMPLE",
                "secret_access_key": "example-secret"
            },
            "secret_backend": {
                "mode": "manual",
                "name": "ns8-openbao"
            }
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'warpgate.domain.org'",
            "format": "hostname",
            "pattern": "\\."
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "oidc": {
            "type": "object",
            "required": [
                "mode"
            ],
            "properties": {
                "mode": {
                    "enum": [
                        "disabled",
                        "manual",
                        "ns8"
                    ]
                },
                "issuer": {
                    "type": "string"
                },
                "client_id": {
                    "type": "string"
                },
                "provider": {
                    "type": "string"
                },
                "domain": {
                    "type": "string"
                },
                "secret": {
                    "type": "string",
                    "writeOnly": true
                },
                "label": {
                    "type": "string",
                    "maxLength": 120
                }
            },
            "additionalProperties": false
        },
        "oidc_entries": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "mode"
                ],
                "properties": {
                    "mode": {
                        "enum": [
                            "manual",
                            "ns8"
                        ]
                    },
                    "issuer": {
                        "type": "string"
                    },
                    "client_id": {
                        "type": "string"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "domain": {
                        "type": "string"
                    },
                    "secret": {
                        "type": "string",
                        "writeOnly": true
                    },
                    "label": {
                        "type": "string",
                        "maxLength": 120
                    }
                },
                "additionalProperties": false
            }
        },
        "database": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mode"
            ],
            "description": "Database: embedded SQLite (default) or a database of an ns8-postgresql19c instance",
            "properties": {
                "mode": {
                    "enum": [
                        "embedded",
                        "postgresql19c"
                    ]
                },
                "instance": {
                    "type": "string",
                    "pattern": "^([a-z][a-z0-9_-]*[0-9]+)?$",
                    "description": "ns8-postgresql19c module ID, empty to pick one (the instance on this node first)"
                },
                "rotate": {
                    "type": "boolean",
                    "description": "Ask grant-database for a new password"
                }
            }
        },
        "cluster": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mode"
            ],
            "description": "Warpgate cluster membership: several instances sharing one PostgreSQL database",
            "properties": {
                "mode": {
                    "enum": [
                        "standalone",
                        "create",
                        "join"
                    ]
                },
                "peer": {
                    "type": "string",
                    "pattern": "^([a-z][a-z0-9_-]*[0-9]+)?$",
                    "description": "Warpgate instance to join (it must approve this one with set-peer-access)"
                }
            }
        },
        "vault_enabled": {
            "type": "boolean",
            "description": "Mirror the secrets to OpenBao"
        },
        "vault_mode": {
            "enum": [
                "manual",
                "provisioned"
            ]
        },
        "vault_openbao": {
            "type": "string",
            "description": "ns8-openbao module ID (provisioned mode)"
        },
        "vault_reprovision": {
            "type": "boolean"
        },
        "vault_address": {
            "type": "string",
            "description": "VAULT_ADDR (manual mode)"
        },
        "vault_token": {
            "type": "string",
            "writeOnly": true,
            "description": "Token (manual mode); empty keeps the saved one"
        },
        "vault_mount": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]*$"
        },
        "vault_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]*$"
        },
        "recordings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "storage"
            ],
            "description": "Session recordings storage: local disk (default) or an S3-compatible bucket. Missing fields keep their values",
            "properties": {
                "storage": {
                    "enum": [
                        "local",
                        "s3"
                    ]
                },
                "endpoint": {
                    "type": "string",
                    "maxLength": 300,
                    "description": "S3 endpoint URL, like 'https://s3.example.org:9000'. Empty for AWS S3"
                },
                "region": {
                    "type": "string",
                    "maxLength": 63
                },
                "bucket": {
                    "type": "string",
                    "maxLength": 63
                },
                "prefix": {
                    "type": "string",
                    "maxLength": 512,
                    "description": "Key prefix of the recordings (optional)"
                },
                "path_style": {
                    "type": "boolean",
                    "description": "Path-style addressing (host/bucket/key), needed by most S3-compatible services"
                },
                "access_key_id": {
                    "type": "string",
                    "maxLength": 128
                },
                "secret_access_key": {
                    "type": "string",
                    "maxLength": 256,
                    "writeOnly": true,
                    "description": "Empty keeps the saved secret key (same access key ID)"
                }
            }
        },
        "secret_backend": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mode"
            ],
            "description": "Warpgate's own OpenBao secret backend: off (default, manage it in Warpgate), manual (show the values to enter) or managed (registered with the admin API, token from ns8-openbao)",
            "properties": {
                "mode": {
                    "enum": [
                        "off",
                        "manual",
                        "managed"
                    ]
                },
                "name": {
                    "type": "string",
                    "maxLength": 64,
                    "description": "Backend name used in secret:// references"
                },
                "scope": {
                    "enum": [
                        "module",
                        "group"
                    ],
                    "description": "Token of this module's OpenBao prefix, or of a shared group approved in OpenBao"
                },
                "group": {
                    "type": "string",
                    "maxLength": 64
                }
            }
        }
    }
}
