import sys
import json
import agent

request = json.load(sys.stdin)

original_environment = request['environment']

for evar in [
        "TRAEFIK_HOST",
        "TRAEFIK_HTTP2HTTPS",
        "TRAEFIK_LETS_ENCRYPT",
    ]:
    agent.set_env(evar, original_environment[evar])

# Database settings (no secrets): reconnect to the same PostgreSQL database
for evar in [
        "WARPGATE_DB_MODE",
        "WARPGATE_DB_INSTANCE",
        "WARPGATE_DB_PROVIDER",
        "WARPGATE_DB_CLUSTER_ID",
        "WARPGATE_DB_NAME",
        "WARPGATE_DB_USER",
        "WARPGATE_DB_HOST",
        "WARPGATE_DB_PORT",
    ]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

# Recordings storage and Warpgate secret backend settings (no secrets: the
# S3 secret key comes back with state/s3.env)
for evar in [
        "WARPGATE_RECORDINGS_STORAGE",
        "WARPGATE_S3_ENDPOINT",
        "WARPGATE_S3_REGION",
        "WARPGATE_S3_BUCKET",
        "WARPGATE_S3_PREFIX",
        "WARPGATE_S3_PATH_STYLE",
        "WARPGATE_RECORDINGS_APPLIED",
        "WARPGATE_RECORDINGS_DISK_PATH",
        "WARPGATE_SECRET_BACKEND_MODE",
        "WARPGATE_SECRET_BACKEND_NAME",
        "WARPGATE_SECRET_BACKEND_SCOPE",
        "WARPGATE_SECRET_BACKEND_GROUP",
    ]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

agent.dump_env()
