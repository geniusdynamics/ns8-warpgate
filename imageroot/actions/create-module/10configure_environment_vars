import secrets
import agent

# Generate the password of the initial Warpgate "admin" user. It is stored
# in state/warpgate.env, which is included in the module backup, and read
# by Warpgate at first start only.
agent.write_envfile("warpgate.env", {
    "WARPGATE_ADMIN_PASSWORD": secrets.token_hex(16),
})
