#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later

import argparse
import sys

import agent
import warpgate_oidc

parser = argparse.ArgumentParser(description="Refresh Warpgate's registered NS8 OIDC client")
parser.add_argument("--rotate-secret", action="store_true", help="generate a new OIDC client secret")
args = parser.parse_args()

with warpgate_oidc.settings_lock():
    current = warpgate_oidc.read_settings()
    if current["mode"] != "ns8":
        if args.rotate_secret:
            sys.exit("No NS8 OIDC client is configured")
        sys.exit(0)
    try:
        updated = warpgate_oidc.register(current, current, current["callback"], rotate=args.rotate_secret)
    except warpgate_oidc.RegistrationError as error:
        sys.exit(f"Warpgate OIDC refresh failed ({error})")
    if updated != current:
        warpgate_oidc.save_configuration(updated)
        agent.run_helper("systemctl", "--user", "try-restart", "warpgate.service").check_returncode()
